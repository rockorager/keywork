#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

: "${PORT:?PORT must contain the HTTP listen port}"

zig build install -Doptimize=ReleaseSafe

runtime_directory="$(mktemp -d /tmp/keywork-stream.XXXXXX)"
compositor_stdout="$runtime_directory/compositor.stdout"
export XDG_RUNTIME_DIR="$runtime_directory"
chmod 700 "$runtime_directory"

compositor_pid=
terminal_pid=
gateway_pid=
audio_pids=()

cleanup() {
    trap - EXIT INT TERM
    for pid in "$gateway_pid" "$terminal_pid" "$compositor_pid"; do
        if [[ -n "$pid" ]]; then
            kill "$pid" 2>/dev/null || true
        fi
    done
    for pid in "$gateway_pid" "$terminal_pid" "$compositor_pid"; do
        if [[ -n "$pid" ]]; then
            wait "$pid" 2>/dev/null || true
        fi
    done
    for pid in "${audio_pids[@]}"; do
        kill "$pid" 2>/dev/null || true
    done
    for pid in "${audio_pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done
    rm -rf "$runtime_directory"
}
trap cleanup EXIT INT TERM

start_session_audio() {
    export PULSE_SERVER="unix:$runtime_directory/pulse/native"
    if command -v pipewire >/dev/null && command -v pipewire-pulse >/dev/null &&
        command -v wireplumber >/dev/null && command -v pactl >/dev/null; then
        pipewire >"$runtime_directory/pipewire.stdout" 2>"$runtime_directory/pipewire.stderr" &
        audio_pids+=("$!")
        for _ in $(seq 1 100); do
            [[ -S "$runtime_directory/pipewire-0" ]] && break
            sleep 0.02
        done
        wireplumber >"$runtime_directory/wireplumber.stdout" 2>"$runtime_directory/wireplumber.stderr" &
        audio_pids+=("$!")
        pipewire-pulse >"$runtime_directory/pipewire-pulse.stdout" 2>"$runtime_directory/pipewire-pulse.stderr" &
        audio_pids+=("$!")
    elif command -v pulseaudio >/dev/null && command -v pactl >/dev/null; then
        pulseaudio --daemonize=no --exit-idle-time=-1 \
            >"$runtime_directory/pulseaudio.stdout" \
            2>"$runtime_directory/pulseaudio.stderr" &
        audio_pids+=("$!")
    else
        unset PULSE_SERVER
        return
    fi

    for _ in $(seq 1 200); do
        if pactl info >/dev/null 2>&1; then
            if pactl load-module module-null-sink \
                sink_name=keywork_session rate=48000 channels=2 >/dev/null; then
                export PULSE_SINK=keywork_session
                export KEYWORK_AUDIO_SOURCE=keywork_session.monitor
            fi
            return
        fi
        sleep 0.025
    done
    unset PULSE_SERVER
}

start_session_audio

zig-out/bin/keywork-compositor \
    --output headless \
    --renderer cpu \
    --headless-size 1280x720 \
    --headless-refresh 30 \
    --log-level info \
    >"$compositor_stdout" &
compositor_pid=$!

for _ in $(seq 1 200); do
    if grep -q '^WAYLAND_DISPLAY=' "$compositor_stdout"; then
        break
    fi
    if ! kill -0 "$compositor_pid" 2>/dev/null; then
        wait "$compositor_pid"
    fi
    sleep 0.05
done

WAYLAND_DISPLAY="$(sed -n 's/^WAYLAND_DISPLAY=//p' "$compositor_stdout" | tail -n 1)"
if [[ -z "$WAYLAND_DISPLAY" ]]; then
    echo "Keywork compositor did not publish WAYLAND_DISPLAY" >&2
    exit 1
fi
export WAYLAND_DISPLAY
DISPLAY="$(sed -n 's/^DISPLAY=//p' "$compositor_stdout" | tail -n 1)"
if [[ -n "$DISPLAY" ]]; then
    export DISPLAY
else
    unset DISPLAY
fi

# Put a real third-party Wayland terminal on top when the one-off Foot install
# is available.
if command -v foot >/dev/null; then
    sleep 0.5
    foot \
        --fullscreen \
        --app-id dev.keywork.RemoteTerminal \
        --title "Keywork remote shell" \
        --working-directory "$repo_root" \
        >"$runtime_directory/foot.stdout" \
        2>"$runtime_directory/foot.stderr" &
    terminal_pid=$!
fi

zig-out/bin/keywork-stream-gateway \
    -listen "0.0.0.0:$PORT" \
    -streamd zig-out/bin/keywork-streamd \
    -frame-rate 30 \
    -bitrate 12000 &
gateway_pid=$!
wait "$gateway_pid"
