#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 11 ]]; then
    echo "usage: package-release VERSION TARGET OPTIMIZE COMPOSITOR STREAMD GATEWAY SDK_DIR LICENSE STREAM_README BUILD_ZON OUTPUT_DIR" >&2
    exit 2
fi

version=$1
target=$2
optimize=$3
compositor=$4
streamd=$5
gateway=$6
sdk_dir=$7
license=$8
stream_readme=$9
build_zon=${10}
output=${11}

if [[ "$optimize" != ReleaseSafe ]]; then
    echo "release packages require -Doptimize=ReleaseSafe" >&2
    exit 1
fi

zon_version="$(sed -n 's/^[[:space:]]*\.version = "\([^"]*\)",/\1/p' "$build_zon" | head -n 1)"
sdk_version="$(node -p 'JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).version' "$sdk_dir/package.json")"
if [[ "$zon_version" != "$version" || "$sdk_version" != "$version" ]]; then
    printf 'release version mismatch: build=%s zon=%s npm=%s\n' "$version" "$zon_version" "$sdk_version" >&2
    exit 1
fi

temporary="$(mktemp -d)"
trap 'rm -rf "$temporary"' EXIT
mkdir -p "$output"

bundle_name="keywork-$version-$target"
mkdir -p "$temporary/$bundle_name/bin"
install -m0755 "$compositor" "$temporary/$bundle_name/bin/keywork-compositor"
install -m0755 "$streamd" "$temporary/$bundle_name/bin/keywork-streamd"
install -m0755 "$gateway" "$temporary/$bundle_name/bin/keywork-stream-gateway"
install -m0644 "$license" "$temporary/$bundle_name/LICENSE"
install -m0644 "$stream_readme" "$temporary/$bundle_name/README.md"

archive() {
    local name=$1
    TZ=UTC tar \
        --sort=name \
        --mtime='@0' \
        --owner=0 \
        --group=0 \
        --numeric-owner \
        -cf - \
        -C "$temporary" \
        "$name" | gzip -n >"$output/$name.tar.gz"
}

archive "$bundle_name"
npm pack "$sdk_dir" --pack-destination "$output" --silent >/dev/null

(
    cd "$output"
    export LC_ALL=C
    sha256sum -- *.tar.gz *.tgz >SHA256SUMS
)
