[Unit]
Description=Keywork desktop shell
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
# Reload replaces generation-owned D-Bus resources. Type=dbus would terminate
# the shell as soon as its well-known name is released between generations.
Type=exec
ExecStart=%h/.local/bin/keywork-shell
Restart=on-failure

[Install]
WantedBy=graphical-session.target
