# Process-lifetime control interface implemented by every hosted Keywork application.
interface dev.rockorager.keywork.application

type Status (
    appId: string,
    instanceId: string,
    generation: int,
    reloading: bool,
    reloadSupported: bool
)

type Action (
    handle: string,
    id: string,
    enabled: bool,
    inputSchemaJson: ?string
)

type UiSnapshot (
    generation: int,
    snapshotJson: string
)

method GetStatus() -> (status: Status)
method Reload() -> (generation: int)
method ListActions() -> (actions: []Action)
method InvokeAction(handle: string, targetJson: ?string) -> ()
method GetUiSnapshot() -> (snapshot: UiSnapshot)

error ReloadUnsupported()
error ReloadFailed(message: string)
error ActionsUnavailable()
error ActionNotFound()
error ActionFailed(message: string)
error UiUnavailable()
error UiSnapshotFailed(message: string)
